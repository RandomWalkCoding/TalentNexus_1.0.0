HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hr_console?schema=public
NODE_ENV=development
# Same-origin reverse proxy requires no CORS configuration. For a separate Web origin, list exact origins.
CORS_ORIGINS=

# Stage 11: generate a private 32-byte hex key; keep it stable across restarts and backups.
# MAIL_ENCRYPTION_KEY=<64 hex characters>
MAIL_API_ORIGIN=http://localhost:5173
MAIL_WEB_ORIGIN=http://localhost:5173
# Register MAIL_API_ORIGIN/api/v1/mail/oauth/google/callback and /microsoft/callback.
# MAIL_GOOGLE_CLIENT_ID=
# MAIL_GOOGLE_CLIENT_SECRET=
# MAIL_MICROSOFT_CLIENT_ID=
# MAIL_MICROSOFT_CLIENT_SECRET=
MAIL_MICROSOFT_TENANT=common
MAIL_WORKER_ENABLED=true
MAIL_TIMEZONE=Asia/Shanghai
MAIL_SEND_START_HOUR=9
MAIL_SEND_END_HOUR=18
MAIL_DAILY_LIMIT=100
MAIL_MIN_INTERVAL_SECONDS=60
MAIL_SYNC_INTERVAL_SECONDS=300
MAIL_BODY_RETENTION_DAYS=90
