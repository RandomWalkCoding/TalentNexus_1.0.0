{
  "name": "@hr-console/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src test prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=15000 --maxWorkers=1",
    "build": "tsc --project tsconfig.build.json && node scripts/copy-prisma-client.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@hr-console/contracts": "workspace:*",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "vitest": "^4.0.8"
  }
}
