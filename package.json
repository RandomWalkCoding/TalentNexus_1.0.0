{
  "name": "hr-console",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @hr-console/api --filter @hr-console/web dev",
    "start:product": "powershell -ExecutionPolicy Bypass -File ./start-product.ps1",
    "ops:check": "powershell -ExecutionPolicy Bypass -File ./scripts/ops-preflight.ps1",
    "dev:api": "corepack pnpm --filter @hr-console/api dev",
    "dev:web": "corepack pnpm --filter @hr-console/web dev",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "build": "corepack pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
